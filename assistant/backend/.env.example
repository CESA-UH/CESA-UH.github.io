# Defaults to local SQLite if DATABASE_URL is omitted.
# DATABASE_URL=postgresql://username:password@localhost:5432/learning
DEBUG=false
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Keep the actual secret only in the ignored backend/.env.local.
LLM_API_KEY=
LLM_BASE_URL=https://ai.verbo.ir/v1
LLM_MODEL=cf/@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Optional comma-separated models, attempted in order; overrides LLM_MODEL.
LLM_MODELS=cf/@cf/meta/llama-3.1-8b-instruct-fp8-fast,cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast,cf/@cf/meta/llama-3.1-70b-instruct-fp8-fast,cf/@cf/meta/llama-3.2-3b-instruct,cf/@cf/meta/llama-3.2-1b-instruct
# chat_completions for /v1/chat/completions, responses for /v1/responses.
LLM_API_FORMAT=chat_completions
LLM_TIMEOUT_SECONDS=60

# Durable background reports. Limit concurrent report jobs to control provider load.
REPORT_WORKER_ENABLED=true
REPORT_WORKER_CONCURRENCY=1
# Optional report-model order; only names also in LLM_MODELS and without gpt are used.
REPORT_LLM_MODELS=cf/@cf/meta/llama-3.3-70b-instruct-fp8-fast,cf/@cf/meta/llama-3.1-70b-instruct-fp8-fast
REPORT_LLM_TIMEOUT_SECONDS=180

# Optional built course-docs checkout; only public assets and courses are served.
ECE_DOCS_PATH=

# Optional persistent cloud deployment; set secrets in the hosting dashboard.
CLOUD_DEPLOYMENT=false
DATABASE_SCHEMA=
SITE_FILE_STORAGE=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=hamdars-files
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
